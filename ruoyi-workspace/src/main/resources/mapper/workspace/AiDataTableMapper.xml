<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.workspace.mapper.AiDataTableMapper">

    <resultMap type="com.ruoyi.workspace.domain.AiDataTable" id="AiDataTableResult">
        <result property="tableId"          column="table_id"          />
        <result property="workspaceId"      column="workspace_id"      />
        <result property="tableName"        column="table_name"        />
        <result property="tableDescription" column="table_description" />
        <result property="status"           column="status"            />
        <result property="delFlag"          column="del_flag"          />
        <result property="createBy"         column="create_by"         />
        <result property="createTime"       column="create_time"       />
        <result property="updateBy"         column="update_by"         />
        <result property="updateTime"       column="update_time"       />
        <result property="remark"           column="remark"            />
    </resultMap>

    <sql id="selectAiDataTableVo">
        select table_id, workspace_id, table_name, table_description, status, del_flag, create_by, create_time, update_by, update_time, remark from ai_data_table
    </sql>

    <select id="selectAiDataTableList" parameterType="com.ruoyi.workspace.domain.AiDataTable" resultMap="AiDataTableResult">
        <include refid="selectAiDataTableVo"/>
        <where>
            <if test="workspaceId != null "> and workspace_id = #{workspaceId}</if>
            <if test="tableName != null  and tableName != ''"> and table_name like concat('%', #{tableName}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            and del_flag = '0'
        </where>
    </select>

    <select id="selectAiDataTableByTableId" parameterType="Long" resultMap="AiDataTableResult">
        <include refid="selectAiDataTableVo"/>
        where table_id = #{tableId} and del_flag = '0'
    </select>

    <insert id="insertAiDataTable" parameterType="com.ruoyi.workspace.domain.AiDataTable" useGeneratedKeys="true" keyProperty="tableId">
        insert into ai_data_table
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="workspaceId != null">workspace_id,</if>
            <if test="tableName != null and tableName != ''">table_name,</if>
            <if test="tableDescription != null">table_description,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time,
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="workspaceId != null">#{workspaceId},</if>
            <if test="tableName != null and tableName != ''">#{tableName},</if>
            <if test="tableDescription != null">#{tableDescription},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate(),
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateAiDataTable" parameterType="com.ruoyi.workspace.domain.AiDataTable">
        update ai_data_table
        <trim prefix="SET" suffixOverrides=",">
            <if test="workspaceId != null">workspace_id = #{workspaceId},</if>
            <if test="tableName != null and tableName != ''">table_name = #{tableName},</if>
            <if test="tableDescription != null">table_description = #{tableDescription},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate(),
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where table_id = #{tableId}
    </update>

    <update id="deleteAiDataTableByTableId" parameterType="Long">
        update ai_data_table set del_flag = '2' where table_id = #{tableId}
    </update>

    <update id="deleteAiDataTableByTableIds" parameterType="String">
        update ai_data_table set del_flag = '2' where table_id in
        <foreach item="tableId" collection="array" open="(" separator="," close=")">
            #{tableId}
        </foreach>
    </update>
</mapper>
