<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.workspace.mapper.AiWorkspaceMapper">

    <resultMap type="com.ruoyi.workspace.domain.AiWorkspace" id="AiWorkspaceResult">
        <result property="workspaceId"    column="workspace_id"    />
        <result property="workspaceName"  column="workspace_name"  />
        <result property="description"    column="description"     />
        <result property="status"         column="status"          />
        <result property="delFlag"        column="del_flag"        />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"     column="update_time"     />
        <result property="remark"         column="remark"          />
    </resultMap>

    <sql id="selectAiWorkspaceVo">
        select workspace_id, workspace_name, description, status, del_flag, create_by, create_time, update_by, update_time, remark from ai_workspace
    </sql>

    <select id="selectAiWorkspaceList" parameterType="com.ruoyi.workspace.domain.AiWorkspace" resultMap="AiWorkspaceResult">
        <include refid="selectAiWorkspaceVo"/>
        <where>
            <if test="workspaceName != null  and workspaceName != ''"> and workspace_name like concat('%', #{workspaceName}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="createBy != null and createBy != ''"> and create_by = #{createBy}</if>
            <!-- del_flag = '0' to select non-deleted records -->
            and del_flag = '0'
        </where>
    </select>

    <select id="selectAiWorkspaceByWorkspaceId" parameterType="Long" resultMap="AiWorkspaceResult">
        <include refid="selectAiWorkspaceVo"/>
        where workspace_id = #{workspaceId} and del_flag = '0'
    </select>

    <insert id="insertAiWorkspace" parameterType="com.ruoyi.workspace.domain.AiWorkspace" useGeneratedKeys="true" keyProperty="workspaceId">
        insert into ai_workspace
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="workspaceName != null and workspaceName != ''">workspace_name,</if>
            <if test="description != null">description,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time,
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="workspaceName != null and workspaceName != ''">#{workspaceName},</if>
            <if test="description != null">#{description},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate(),
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateAiWorkspace" parameterType="com.ruoyi.workspace.domain.AiWorkspace">
        update ai_workspace
        <trim prefix="SET" suffixOverrides=",">
            <if test="workspaceName != null and workspaceName != ''">workspace_name = #{workspaceName},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate(),
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where workspace_id = #{workspaceId}
    </update>

    <update id="deleteAiWorkspaceByWorkspaceId" parameterType="Long">
        update ai_workspace set del_flag = '2' where workspace_id = #{workspaceId}
    </update>

    <update id="deleteAiWorkspaceByWorkspaceIds" parameterType="String">
        update ai_workspace set del_flag = '2' where workspace_id in
        <foreach item="workspaceId" collection="array" open="(" separator="," close=")">
            #{workspaceId}
        </foreach>
    </update>
</mapper>
